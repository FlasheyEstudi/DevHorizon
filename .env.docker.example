# =============================================================================
# .env.docker.example — variables para el stack autoalojado (Docker Compose)
# =============================================================================
#   cp .env.docker.example .env.docker   &&   editar los valores
#
# Este archivo NO se versiona con valores reales: `.env.docker` está en
# .gitignore. Nunca subas credenciales al repositorio.
# =============================================================================

# --- Superusuario de PocketBase (OBLIGATORIO) --------------------------------
# Se usa para: seed y scripts, métricas del dashboard y el estado 2FA
# (verificación en dos pasos). Debe coincidir con las credenciales que quieras
# tener en el panel /_/ de PocketBase.
# El contenedor de PocketBase las aplica al arrancar (`superuser upsert`).
POCKETBASE_ADMIN_EMAIL=admin@artesanica.local
POCKETBASE_ADMIN_PASSWORD=cambia-esta-clave-por-una-larga-y-unica

# --- Origen público del sitio -------------------------------------------------
# Lo usa la protección CSRF (lista de orígenes permitidos en mutaciones).
# Si el mismo origen ya coincide, la validación pasa sin configurar nada.
# Ejemplos: http://localhost  ·  http://192.168.1.50  ·  https://artesanica.com.ni
PUBLIC_SITE_ORIGIN=http://localhost

# Orígenes extra separados por coma (opcional): útil si accedes por IP y por
# nombre a la vez.
PUBLIC_ALLOWED_ORIGINS=

# --- Notas -------------------------------------------------------------------
# POCKETBASE_URL y PUBLIC_POCKETBASE_URL las fija docker-compose.yml:
#   POCKETBASE_URL=http://pocketbase:8090   (red interna, sólo servidor)
#   PUBLIC_POCKETBASE_URL=/pb               (mismo origen, a través de nginx)
# No las definas aquí salvo que sepas por qué.
