# =============================================================================
# ArtesaNica — Variables de entorno
# =============================================================================
# Copiar este archivo a `.env` y completar los valores reales.
# NUNCA commitear `.env` (esta en .gitignore).
# =============================================================================

# URL del servicio PocketBase (servidor).
# En local: http://127.0.0.1:8090
# En produccion (PocketBase Cloud): https://<tu-instancia>.pocketbase.cloud
# o self-hosted: https://pb.tu-dominio.com
POCKETBASE_URL=http://127.0.0.1:8090

# Token de admin de PocketBase. Se genera desde el panel admin de PocketBase
# (Settings > Admins) o via CLI. Solo se usa server-side para operaciones
# privilegiadas (crear colecciones, seed, etc.).
POCKETBASE_ADMIN_TOKEN=

# URL publica de PocketBase que vera el cliente (browser).
# Debe coincidir con POCKETBASE_URL salvo que uses un proxy o CDN.
# El prefijo PUBLIC_ lo expone al bundle del cliente.
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
