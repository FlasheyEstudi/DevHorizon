# =============================================================================
# ArtesaNica — HTTPS (:443) con certificado de Let's Encrypt
# =============================================================================
# ESTE ARCHIVO ES UNA PLANTILLA: no se carga mientras se llame `.example`.
#
# Requisitos previos:
#   1. Un dominio real apuntando (registro A/AAAA) a la IP pública de esta
#      máquina, y los puertos 80 y 443 abiertos en el router/firewall.
#   2. `sudo pacman -S certbot certbot-nginx`
#
# Emisión del certificado (elige UNA opción):
#
#   A) certbot gestiona nginx (reescribe el vhost y añade el redirect):
#        sudo certbot --nginx -d artesanica.com.ni -d www.artesanica.com.ni
#
#   B) certbot sólo emite el certificado (el vhost lo pones tú, ver abajo):
#        sudo certbot certonly --webroot -w /var/lib/letsencrypt \
#             -d artesanica.com.ni -d www.artesanica.com.ni
#
# Renovación automática (certbot instala un timer de systemd):
#        systemctl list-timers | grep certbot
#        sudo certbot renew --dry-run
#
# Para activar esta plantilla:
#   sudo cp infra/nginx/conf.d/artesanica-tls.conf.example /etc/nginx/conf.d/artesanica-tls.conf
#   # editar `server_name` y las rutas del certificado
#   # y en /etc/nginx/conf.d/artesanica.conf cambiar el vhost :80 por el
#   # redirect que aparece al final de este archivo
#   sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name artesanica.com.ni www.artesanica.com.ni;   # <<< tu dominio

    # Certificados emitidos por certbot (opción B)
    ssl_certificate     /etc/letsencrypt/live/artesanica.com.ni/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/artesanica.com.ni/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/artesanica.com.ni/chain.pem;

    # Configuración TLS recomendada (Mozilla "intermediate")
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_stapling              on;
    ssl_stapling_verify       on;

    # HSTS: sólo tiene sentido cuando el HTTPS ya funciona de forma estable.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    include /etc/nginx/snippets/security-headers.conf;

    location /_astro/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://artesanica_web;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location /pb/api/files/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://artesanica_pb/api/files/;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=3600";
    }

    location /pb/ {
        return 404;
    }

    location = /_/ {
        return 404;
    }

    location /api/auth/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://artesanica_web;
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        limit_req zone=api burst=100 nodelay;
        proxy_pass http://artesanica_web;
    }

    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://artesanica_web;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}

# -----------------------------------------------------------------------------
# Vhost :80 cuando ya hay HTTPS: sólo redirige (y mantiene el desafío ACME).
# Reemplaza con este bloque el contenido de servidor de artesanica.conf.
# -----------------------------------------------------------------------------
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name artesanica.com.ni www.artesanica.com.ni;
#
#     location /.well-known/acme-challenge/ {
#         root /var/lib/letsencrypt;
#         default_type text/plain;
#         access_log off;
#     }
#
#     location / {
#         return 301 https://$host$request_uri;
#     }
# }
