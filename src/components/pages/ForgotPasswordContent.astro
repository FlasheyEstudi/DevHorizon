---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const l = (path: string) => localizePath(path, lang);
---

<section class="py-12">
  <div class="max-w-md mx-auto px-4">
    <h1 class="text-3xl font-bold text-texto mb-3">{t('auth.forgotPassword.title')}</h1>
    <p class="text-texto-secundario mb-6">{t('auth.forgotPassword.subtitle')}</p>

    <form id="forgot-form" class="space-y-4">
      <div>
        <label for="forgot-email" class="block text-sm font-medium text-texto mb-1">{t('auth.forgotPassword.email')}</label>
        <input
          type="email"
          id="forgot-email"
          name="email"
          required
          autocomplete="email"
          class="w-full px-4 py-2 border border-borde rounded-lg bg-blanco text-texto focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <button
        type="submit"
        class="w-full bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-dark transition-colors"
      >
        {t('auth.forgotPassword.submit')}
      </button>

      <div
        id="forgot-message"
        class="hidden p-3 rounded-lg bg-fondo text-texto text-sm"
        data-success-message={t('auth.forgotPassword.success')}
      ></div>

      <a href={l('/login')} class="block text-center text-primary hover:text-primary-dark text-sm">
        {t('auth.forgotPassword.backToLogin')}
      </a>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('forgot-form') as HTMLFormElement | null;
  const message = document.getElementById('forgot-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!message) return;
    const data = new FormData(form);
    const successMessage = message.dataset.successMessage ?? '';

    // Read CSRF token from cookie (double-submit pattern).
    const csrfCookie = document.cookie.split('; ').find(c => c.startsWith('csrf-token='));
    const csrfToken = csrfCookie?.split('=')[1] ?? '';

    try {
      await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify({ email: data.get('email') }),
      });
      // Always show success — endpoint is enumeration-safe.
      message.textContent = successMessage;
      message.classList.remove('hidden');
      message.className = 'p-3 rounded-lg bg-fondo text-texto text-sm';
    } catch {
      message.textContent = 'Error de red';
      message.classList.remove('hidden');
      message.className = 'p-3 rounded-lg bg-error/10 text-error text-sm';
    }
  });
</script>
