<!-- Productos destacados -->
<section id="productos" class="py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-texto">
        {t("sections.featuredProducts")}
      </h2>
      <a
        class="text-sm text-primary hover:text-primary-dark font-medium inline-flex items-center gap-1"
        href={l("/productos")}
      >
        {t("actions.seeMoreProducts")}
        <Icon name="lucide:arrow-right" class="text-base" />
      </a>
    </div>
    {
      products.items.length === 0 ? (
        <p class="text-texto-secundario text-center py-8">
          {t("product.empty")}
        </p>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5 sm:gap-3">
          {products.items.map((p) => {
            const img = productImageUrl(p);
            const storeName = p.expand?.store?.name;
            const firstCategory = p.expand?.categories?.[0];
            const stars = renderStars(p.rating_avg ?? 0);
            return (
              <a
                href={l(`/productos/${p.slug}`)}
                class="group bg-blanco rounded-xl overflow-hidden border border-borde hover:border-primary/40 hover:shadow-card transition-all flex flex-col"
              >
                <div class="relative aspect-square overflow-hidden bg-fondo">
                  {img ? (
                    <img
                      src={img}
                      alt={p.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-texto-secundario text-3xl">
                      <Icon name="lucide:image" />
                    </div>
                  )}
                  {firstCategory?.name && (
                    <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 text-[10px] font-medium bg-blanco/95 backdrop-blur text-texto rounded-full max-w-[70%] truncate">
                      {firstCategory.name}
                    </span>
                  )}
                </div>
                <div class="p-2.5 sm:p-3 flex-1 flex flex-col gap-1">
                  {(p.rating_count ?? 0) > 0 && (
                    <div class="flex items-center gap-1 text-[11px] text-texto-secundario">
                      <span class="flex text-rating" aria-hidden="true">
                        {stars.map((filled) => (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="10"
                            height="10"
                            viewBox="0 0 24 24"
                            fill={filled ? "currentColor" : "none"}
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                          </svg>
                        ))}
                      </span>
                      <span>({p.rating_count})</span>
                    </div>
                  )}
                  <h3 class="text-sm font-medium text-texto line-clamp-1 leading-snug">
                    {p.name}
                  </h3>
                  <p class="text-sm font-bold text-primary leading-tight">
                    C$ {(p.price ?? 0).toFixed(2)}
                  </p>
                  {storeName && (
                    <p class="text-[11px] text-texto-secundario truncate">
                      {storeName}
                    </p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<!-- Tiendas destacadas -->
<section id="tiendas" class="py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-texto">
        {t("sections.featuredStores")}
      </h2>
      <a
        class="text-sm text-primary hover:text-primary-dark font-medium inline-flex items-center gap-1"
        href={l("/tiendas")}
      >
        {t("actions.seeMoreStores")}
        <Icon name="lucide:arrow-right" class="text-base" />
      </a>
    </div>
    {
      stores.items.length === 0 ? (
        <p class="text-texto-secundario text-center py-8">{t("store.empty")}</p>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5 sm:gap-3">
          {stores.items.map((s) => {
            const logo = storeLogoUrl(s);
            return (
              <a
                href={l(`/tiendas/${s.slug}`)}
                class="group bg-blanco rounded-xl overflow-hidden border border-borde hover:border-primary/40 hover:shadow-card transition-all flex flex-col"
              >
                <div class="relative aspect-square overflow-hidden bg-fondo flex items-center justify-center">
                  {logo ? (
                    <img
                      src={logo}
                      alt={s.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex items-center justify-center w-full h-full text-texto-secundario text-3xl">
                      <Icon name="lucide:store" />
                    </div>
                  )}
                  {s.department && (
                    <span class="absolute top-1.5 left-1.5 inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium bg-blanco/95 backdrop-blur text-texto rounded-full">
                      <Icon
                        name="lucide:map-pin"
                        class="text-[10px] text-primary"
                      />
                      {s.department}
                    </span>
                  )}
                </div>
                <div class="p-2.5 sm:p-3 flex-1 flex flex-col gap-0.5">
                  <h3 class="text-sm font-semibold text-texto line-clamp-1">
                    {s.name}
                  </h3>
                  {s.description && (
                    <p class="text-xs text-texto-secundario line-clamp-2 leading-snug">
                      {s.description}
                    </p>
                  )}
                  {s.address_text && (
                    <p class="text-[11px] text-texto-secundario inline-flex items-center gap-1 mt-auto pt-0.5 truncate">
                      <Icon
                        name="lucide:map-pin"
                        class="text-[10px] shrink-0"
                      />
                      <span class="truncate">{s.address_text}</span>
                    </p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</section>

