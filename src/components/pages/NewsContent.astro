</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.news-filter-btn');
  const articles   = document.querySelectorAll<HTMLElement>('[data-category]');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'todo';
      filterBtns.forEach(b => b.classList.remove('news-filter-btn--active'));
      btn.classList.add('news-filter-btn--active');
      articles.forEach(article => {
        const cat  = article.dataset.category ?? '';
        article.style.display = (filter === 'todo' || cat === filter) ? '' : 'none';
      });
    });
  });
</script>