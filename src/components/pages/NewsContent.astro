/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .news-grid { grid-template-columns: repeat(2, 1fr); }
  .news-card--featured { grid-column: span 2; flex-direction: column; }
  .news-card__image-wrap--featured { width: 100%; aspect-ratio: 16/9; }
}
