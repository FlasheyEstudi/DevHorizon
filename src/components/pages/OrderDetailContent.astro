---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface OrderItem {
  productId: string;
  name?: string;
  price?: number;
  quantity?: number;
  image?: string;
}

interface ShippingAddress {
  name?: string;
  phone?: string;
  address?: string;
  city?: string;
  department?: string;
  reference?: string;
}

export interface OrderData {
  id: string;
  user: string;
  items: OrderItem[];
  total: number;
  status: 'pending' | 'paid' | 'shipped' | 'delivered' | 'cancelled';
  shipping_address: ShippingAddress;
  payment_method?: 'cash' | 'transfer' | 'card' | 'other' | string;
  notes?: string;
  created?: string;
  created_at?: string;
  updated?: string;
}

interface Props {
  lang: Lang;
  order: OrderData | null;
  errorType?: 'notFound' | 'unauthorized' | null;
}

const { lang, order, errorType = null } = Astro.props;
const t = useTranslations(lang);
const l = (path: string) => localizePath(path, lang);

const statusBadgeMap: Record<string, { labelKey: string; bg: string; text: string; icon: string }> = {
  pending: { labelKey: 'order.status.pending', bg: 'bg-amber-100 dark:bg-amber-950/40 border-amber-300 dark:border-amber-700', text: 'text-amber-800 dark:text-amber-300', icon: '⏳' },
  paid: { labelKey: 'order.status.paid', bg: 'bg-blue-100 dark:bg-blue-950/40 border-blue-300 dark:border-blue-700', text: 'text-blue-800 dark:text-blue-300', icon: '✓' },
  shipped: { labelKey: 'order.status.shipped', bg: 'bg-indigo-100 dark:bg-indigo-950/40 border-indigo-300 dark:border-indigo-700', text: 'text-indigo-800 dark:text-indigo-300', icon: '📦' },
  delivered: { labelKey: 'order.status.delivered', bg: 'bg-emerald-100 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-700', text: 'text-emerald-800 dark:text-emerald-300', icon: '✓✓' },
  cancelled: { labelKey: 'order.status.cancelled', bg: 'bg-red-100 dark:bg-red-950/40 border-red-300 dark:border-red-700', text: 'text-red-800 dark:text-red-300', icon: '✕' },
};

const currentStatus = order ? (statusBadgeMap[order.status] ?? statusBadgeMap.pending) : statusBadgeMap.pending;

const paymentMethodMap: Record<string, string> = {
  cash: t('order.payment.cash'),
  transfer: t('order.payment.transfer'),
  card: t('order.payment.card'),
  other: t('order.payment.other'),
};

const paymentLabel = order?.payment_method
  ? (paymentMethodMap[order.payment_method] || order.payment_method)
  : t('order.payment.cash');

const formattedDate = order
  ? new Date(order.created_at || order.created || Date.now()).toLocaleDateString(
      lang === 'en' ? 'en-US' : 'es-NI',
      {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }
    )
  : '';

// Generar mensaje de WhatsApp preformateado para seguimiento
const waCustomerName = order?.shipping_address?.name || 'Cliente';
const waOrderId = order?.id || '';
const waTotal = order ? Number(order.total).toFixed(2) : '0.00';
const waCleanPhone = (order?.shipping_address?.phone || '').replace(/\D/g, '');
const targetPhone = waCleanPhone.length === 8 ? `505${waCleanPhone}` : (waCleanPhone || '50588888888');

const waFollowUpMsg = `¡Hola! Confirmo los detalles de mi pedido en ArtesaNica:
📦 *Orden #:* ${waOrderId}
👤 *Cliente:* ${waCustomerName}
💰 *Total:* C$ ${waTotal}
💳 *Pago:* ${paymentLabel}
¿Podrían confirmarme el estado de mi envío o datos para coordinar la entrega? ¡Muchas gracias!`;

const waUrl = `https://api.whatsapp.com/send?phone=${targetPhone}&text=${encodeURIComponent(waFollowUpMsg)}`;
---

<div class="py-8 md:py-12 bg-fondo min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    {errorType || !order ? (
      /* Estado de Error o No Encontrado */
      <div class="bg-blanco border border-borde rounded-2xl p-8 sm:p-12 text-center shadow-card max-w-xl mx-auto my-12 animate-in fade-in">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400 flex items-center justify-center text-3xl">
          ⚠️
        </div>
        <h1 class="text-2xl font-bold text-texto mb-2">{t('order.notFound.title')}</h1>
        <p class="text-texto-secundario text-sm mb-6 leading-relaxed">
          {t('order.notFound.desc')}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={l('/perfil')}
            class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-borde text-texto hover:bg-fondo transition-colors font-medium text-sm"
          >
            {t('order.actions.viewMyOrders')}
          </a>
          <a
            href={l('/productos')}
            class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-primary hover:bg-primary-dark text-white font-medium text-sm transition-colors shadow-sm"
          >
            {t('order.notFound.back')}
          </a>
        </div>
      </div>
    ) : (
      /* Vista Exitosa de Confirmación y Recibo */
      <div>
        <!-- Breadcrumb (No print) -->
        <nav class="no-print flex items-center gap-2 text-xs text-texto-secundario mb-6 overflow-x-auto whitespace-nowrap">
          <a href={l('/')} class="hover:text-primary transition-colors">{t('nav.home')}</a>
          <span>/</span>
          <a href={l('/perfil')} class="hover:text-primary transition-colors">{t('profile.sidebar.orders')}</a>
          <span>/</span>
          <span class="text-texto font-medium">#{order.id}</span>
        </nav>

        <!-- Banner de Confirmación (No print) -->
        <div class="no-print bg-gradient-to-r from-emerald-500/10 via-primary/5 to-transparent border border-emerald-500/30 rounded-2xl p-6 sm:p-8 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full mb-1">
                {t('order.badge.success')}
              </span>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-texto tracking-tight">
                {t('order.confirmation.title')}
              </h1>
              <p class="text-texto-secundario text-sm sm:text-base mt-1 max-w-xl">
                {t('order.confirmation.subtitle')}
              </p>
            </div>
          </div>

          <!-- Botones de Acción Primaria (No print) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 w-full sm:w-auto shrink-0">
            <button
              id="print-receipt-btn"
              type="button"
              onclick="window.print()"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-sm transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span>{t('order.actions.print')}</span>
            </button>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all shadow-sm active:scale-95"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- TARJETA PRINCIPAL DEL RECIBO / COMPROBANTE (Print & Screen)  -->
        <!-- ============================================================ -->
        <article class="receipt-card bg-blanco border border-borde rounded-2xl shadow-card p-6 sm:p-10 mb-8 overflow-hidden">
          
          <!-- Encabezado Oficial del Recibo -->
          <header class="border-b border-borde pb-6 mb-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-3">
                  <span class="text-2xl font-black text-primary tracking-tight">Artesa<span class="text-secondary">Nica</span></span>
                  <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
                    Recibo Oficial
                  </span>
                </div>
                <p class="text-xs text-texto-secundario mt-1">
                  {t('order.receipt.issuedBy')} • <a href="https://artesanica.ni" class="hover:underline">artesanica.ni</a>
                </p>
              </div>

              <!-- Metadatos de la Orden -->
              <div class="text-left sm:text-right">
                <div class="inline-flex items-center gap-2">
                  <span class="text-xs font-semibold text-texto-secundario">{t('order.number')}:</span>
                  <span class="font-mono text-sm sm:text-base font-bold text-texto bg-fondo px-2.5 py-1 rounded border border-borde select-all">
                    #{order.id}
                  </span>
                </div>
                <p class="text-xs text-texto-secundario mt-1">
                  {formattedDate}
                </p>
                <div class="mt-2">
                  <span class={`inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold border ${currentStatus.bg} ${currentStatus.text}`}>
                    <span aria-hidden="true">{currentStatus.icon}</span>
                    <span>{t(currentStatus.labelKey)}</span>
                  </span>
                </div>
              </div>
            </div>
          </header>

          <!-- Bloque de 2 Columnas: Datos del Cliente y Método de Pago -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6 mb-6 border-b border-borde">
            <!-- Columna Izquierda: Información de Envío -->
            <div class="bg-fondo/60 dark:bg-fondo/20 p-4 sm:p-5 rounded-xl border border-borde">
              <h2 class="text-xs font-bold uppercase tracking-wider text-texto-secundario mb-3 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {t('order.customer')}
              </h2>
              <div class="space-y-1.5 text-sm text-texto">
                <p class="font-bold text-base text-texto">{order.shipping_address?.name || 'Cliente'}</p>
                {order.shipping_address?.phone && (
                  <p class="text-texto-secundario flex items-center gap-1.5">
                    <span>📞</span> <a href={`tel:${order.shipping_address.phone}`} class="hover:text-primary">{order.shipping_address.phone}</a>
                  </p>
                )}
                {order.shipping_address?.department && (
                  <p class="text-texto-secundario">
                    <span class="font-medium text-texto">{t('order.department')}:</span> {order.shipping_address.department}
                  </p>
                )}
                {order.shipping_address?.address && (
                  <p class="text-texto-secundario">
                    <span class="font-medium text-texto">{t('order.shipping')}:</span> {order.shipping_address.address}
                  </p>
                )}
              </div>
            </div>

            <!-- Columna Derecha: Método de Pago y Notas -->
            <div class="bg-fondo/60 dark:bg-fondo/20 p-4 sm:p-5 rounded-xl border border-borde flex flex-col justify-between">
              <div>
                <h2 class="text-xs font-bold uppercase tracking-wider text-texto-secundario mb-3 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                  </svg>
                  {t('order.payment')}
                </h2>
                <div class="space-y-1 text-sm">
                  <p class="font-semibold text-texto flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    {paymentLabel}
                  </p>
                  <p class="text-xs text-texto-secundario">
                    Moneda: Córdobas Nicaragüenses (NIO / C$)
                  </p>
                </div>
              </div>

              {order.notes && (
                <div class="mt-4 pt-3 border-t border-borde/70 text-xs text-texto-secundario">
                  <p class="font-semibold text-texto mb-0.5">{t('order.notes')}:</p>
                  <p class="italic">"{order.notes}"</p>
                </div>
              )}
            </div>
          </div>

          <!-- Tabla de Productos Adquiridos -->
          <div class="mb-6">
            <h2 class="text-sm font-bold text-texto uppercase tracking-wider mb-4">
              {t('order.items')}
            </h2>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm border-collapse">
                <thead>
                  <tr class="border-b-2 border-borde text-xs font-bold uppercase text-texto-secundario">
                    <th scope="col" class="py-3 px-2 sm:px-3">{t('order.item')}</th>
                    <th scope="col" class="py-3 px-2 sm:px-3 text-center">{t('order.qty')}</th>
                    <th scope="col" class="py-3 px-2 sm:px-3 text-right">{t('order.price')}</th>
                    <th scope="col" class="py-3 px-2 sm:px-3 text-right">{t('order.subtotal')}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-borde">
                  {(order.items || []).map((item) => {
                    const price = Number(item.price ?? 0);
                    const qty = Number(item.quantity ?? 1);
                    const lineTotal = price * qty;
                    return (
                      <tr class="hover:bg-fondo/40 transition-colors">
                        <td class="py-3.5 px-2 sm:px-3">
                          <div class="flex items-center gap-3">
                            {item.image ? (
                              <img
                                src={item.image}
                                alt={item.name || 'Producto'}
                                class="w-12 h-12 rounded-lg object-cover border border-borde shrink-0"
                                loading="lazy"
                              />
                            ) : (
                              <div class="w-12 h-12 rounded-lg bg-borde/50 flex items-center justify-center text-texto-secundario text-xs shrink-0">
                                🎨
                              </div>
                            )}
                            <div>
                              <p class="font-medium text-texto leading-snug">{item.name || 'Producto Artesanal'}</p>
                              <span class="text-xs text-texto-secundario">ID: {item.productId}</span>
                            </div>
                          </div>
                        </td>
                        <td class="py-3.5 px-2 sm:px-3 text-center font-medium text-texto">
                          x{qty}
                        </td>
                        <td class="py-3.5 px-2 sm:px-3 text-right text-texto-secundario whitespace-nowrap">
                          C$ {price.toFixed(2)}
                        </td>
                        <td class="py-3.5 px-2 sm:px-3 text-right font-semibold text-texto whitespace-nowrap">
                          C$ {lineTotal.toFixed(2)}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Resumen de Costos y Total -->
          <div class="flex justify-end pt-4 border-t-2 border-borde">
            <div class="w-full sm:w-72 space-y-2 text-sm">
              <div class="flex justify-between text-texto-secundario">
                <span>{t('order.subtotal')}</span>
                <span>C$ {Number(order.total).toFixed(2)}</span>
              </div>
              <div class="flex justify-between text-texto-secundario">
                <span>{t('order.shippingCost')}</span>
                <span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">{t('order.shippingCostVal')}</span>
              </div>
              <div class="flex justify-between text-base sm:text-lg font-extrabold text-texto pt-2 border-t border-borde">
                <span class="text-primary">{t('order.total')}</span>
                <span class="text-primary font-mono">C$ {Number(order.total).toFixed(2)}</span>
              </div>
            </div>
          </div>

          <!-- Pie del Recibo Oficial (Visible siempre, especialmente en impresión) -->
          <footer class="mt-10 pt-6 border-t border-dashed border-borde text-center text-xs text-texto-secundario space-y-2">
            <p class="font-medium text-texto">{t('order.receipt.thankYou')}</p>
            <p class="max-w-md mx-auto leading-relaxed text-[11px]">
              {t('order.receipt.footerNote')}
            </p>
            <p class="text-[10px] text-texto-secundario/80 pt-1">
              ArtesaNica • Managua, Nicaragua • {t('order.receipt.support')}
            </p>
          </footer>
        </article>

        <!-- Barra de Navegación Secundaria (No print) -->
        <div class="no-print flex flex-col sm:flex-row items-center justify-between gap-4 pt-4">
          <a
            href={l('/perfil')}
            class="inline-flex items-center gap-2 text-sm font-semibold text-texto-secundario hover:text-texto transition-colors"
          >
            ← {t('order.actions.viewMyOrders')}
          </a>

          <div class="flex items-center gap-3">
            <button
              type="button"
              onclick="window.print()"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-borde text-sm font-semibold text-texto hover:bg-blanco transition-colors shadow-sm cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span>{t('order.actions.print')}</span>
            </button>
            <a
              href={l('/productos')}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-sm font-semibold transition-colors shadow-sm"
            >
              <span>{t('order.actions.continueShopping')}</span>
              →
            </a>
          </div>
        </div>
      </div>
    )}

  </div>
</div>

<style>
  /* ============================================================ */
  /* Reglas de Impresión (@media print) para Recibo Oficial       */
  /* ============================================================ */
  @media print {
    @page {
      margin: 1.2cm;
      size: auto;
    }

    /* Ocultar elementos no deseados de la interfaz general */
    :global(header),
    :global(footer),
    :global(nav),
    :global(#toast-container),
    .no-print {
      display: none !important;
    }

    /* Forzar fondo blanco y texto oscuro para óptima legibilidad en papel */
    :global(body),
    :global(html) {
      background: #ffffff !important;
      color: #0f172a !important;
      font-size: 11pt !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    :global(main) {
      padding: 0 !important;
      margin: 0 !important;
      min-height: auto !important;
    }

    /* Ajustar tarjeta de recibo al ancho completo sin sombras de pantalla */
    .receipt-card {
      border: 1px solid #cbd5e1 !important;
      box-shadow: none !important;
      padding: 1.5rem !important;
      margin: 0 !important;
      border-radius: 8px !important;
      page-break-inside: avoid;
    }

    /* Asegurar que las imágenes y filas no se rompan a medias */
    tr {
      page-break-inside: avoid;
    }

    a {
      text-decoration: none !important;
      color: inherit !important;
    }
  }
</style>
