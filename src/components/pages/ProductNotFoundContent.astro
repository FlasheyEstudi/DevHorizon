---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const l = (path: string) => localizePath(path, lang);
---

<section class="py-12">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h1 class="text-3xl font-bold text-texto mb-4">{t('product.notFound')}</h1>
    <p class="text-texto-secundario mb-6">{t('product.notFoundDesc')}</p>
    <a href={l('/productos')} class="inline-block bg-primary text-white px-6 py-3 rounded font-semibold hover:bg-primary-dark transition-colors">
      {t('pages.products.title')}
    </a>
  </div>
</section>