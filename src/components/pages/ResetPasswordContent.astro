---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; token: string | null; }
const { lang, token } = Astro.props;
const t = useTranslations(lang);
const l = (path: string) => localizePath(path, lang);
const successRedirect = l('/login');
---

<section class="py-12">
  <div class="max-w-md mx-auto px-4">
    <h1 class="text-3xl font-bold text-texto mb-6">{t('auth.resetPassword.title')}</h1>

    {!token ? (
      <div class="space-y-4">
        <p class="text-error">{t('auth.resetPassword.invalidToken')}</p>
        <a href={l('/recuperar')} class="inline-block text-primary hover:text-primary-dark">
          {t('auth.forgotPassword.backToLogin')}
        </a>
      </div>
    ) : (
      <form id="reset-form" class="space-y-4">
        <input type="hidden" name="token" value={token} />
        <div>
          <label for="reset-password" class="block text-sm font-medium text-texto mb-1">{t('auth.resetPassword.newPassword')}</label>
          <input
            id="reset-password"
            type="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full px-4 py-2 border border-borde rounded-lg bg-blanco text-texto focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
        <div>
          <label for="reset-password-confirm" class="block text-sm font-medium text-texto mb-1">{t('auth.resetPassword.confirm')}</label>
          <input
            id="reset-password-confirm"
            type="password"
            name="passwordConfirm"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full px-4 py-2 border border-borde rounded-lg bg-blanco text-texto focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
        <button
          type="submit"
          class="w-full bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-dark transition-colors"
        >
          {t('auth.resetPassword.submit')}
        </button>
        <div
          id="reset-message"
          class="hidden p-3 rounded-lg text-sm"
          data-mismatch-message={t('auth.resetPassword.mismatch')}
          data-redirect={successRedirect}
        ></div>
      </form>
    )}
  </div>
</section>

<script>
  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const message = document.getElementById('reset-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!message) return;
    const data = new FormData(form);
    const mismatchMessage = message.dataset.mismatchMessage ?? '';
    const redirect = message.dataset.redirect ?? '/login';

    if (data.get('password') !== data.get('passwordConfirm')) {
      message.textContent = mismatchMessage;
      message.classList.remove('hidden');
      message.className = 'p-3 rounded-lg bg-error/10 text-error text-sm';
      return;
    }

    const csrfCookie = document.cookie.split('; ').find(c => c.startsWith('csrf-token='));
    const csrfToken = csrfCookie?.split('=')[1] ?? '';

    try {
      const res = await fetch('/api/auth/confirm-password-reset', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify({
          token: data.get('token'),
          password: data.get('password'),
          passwordConfirm: data.get('passwordConfirm'),
        }),
      });

      message.classList.remove('hidden');
      if (res.ok) {
        message.textContent = 'Contrasena cambiada. Redirigiendo...';
        message.className = 'p-3 rounded-lg bg-exito/10 text-exito text-sm';
        setTimeout(() => { window.location.href = redirect; }, 1500);
      } else {
        const err = await res.json().catch(() => ({} as { error?: string }));
        message.textContent = err.error || 'Error';
        message.className = 'p-3 rounded-lg bg-error/10 text-error text-sm';
      }
    } catch {
      message.textContent = 'Error de red';
      message.classList.remove('hidden');
      message.className = 'p-3 rounded-lg bg-error/10 text-error text-sm';
    }
  });
</script>
