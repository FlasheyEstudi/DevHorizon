---
// ProductCardSkeleton.astro — Esqueleto animado de tarjeta de producto
---

<div class="bg-blanco dark:bg-zinc-900 rounded-xl shadow-card overflow-hidden flex flex-col border border-borde/40 animate-pulse">
  <!-- Imagen esqueleto -->
  <div class="w-full aspect-square bg-borde/60 dark:bg-zinc-800"></div>

  <!-- Detalle esqueleto -->
  <div class="p-4 flex-1 flex flex-col justify-between gap-3">
    <div class="space-y-2">
      <!-- Categoria/Tag -->
      <div class="h-3 w-1/3 bg-borde/50 dark:bg-zinc-800 rounded"></div>
      <!-- Titulo -->
      <div class="h-4 w-5/6 bg-borde/60 dark:bg-zinc-800 rounded"></div>
      <div class="h-4 w-2/3 bg-borde/60 dark:bg-zinc-800 rounded"></div>
    </div>
    <!-- Precio -->
    <div class="h-5 w-2/5 bg-borde/70 dark:bg-zinc-800 rounded mt-1"></div>
  </div>
</div>
