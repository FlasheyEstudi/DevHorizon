---
// =============================================================================
// AdminLayout.astro — Shell del Panel de Super Admin (/admin).
// =============================================================================
// Version "desnuda" de BaseLayout, como AuthLayout: mismo <head> (Font,
// theme init, meta, i18n) pero SIN el Header/Footer publicos. En su lugar
// monta una barra superior propia del panel (marca, volver al sitio, toggle
// de tema) y deja el <main> para la isla AdminApp.
//
// noindex: el panel no debe indexarse.
// =============================================================================

import '../styles/global.css';

import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import ToastContainer from '../components/ui/ToastContainer';

interface Props {
  title?: string;
}

const { title = 'Panel de Administración — ArtesaNica' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Astro Fonts API — self-hosts Poppins y setea --font-poppins en :root. -->
    <Font cssVariable="--font-poppins" preload />

    <title>{title}</title>

    <!-- Tema light/dark: aplica `.dark` antes del primer paint para evitar FOUC. -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('artesa-theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = stored || (prefersDark ? 'dark' : 'light');
            if (theme === 'dark') {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
            document.documentElement.dataset.theme = theme;
          } catch (_) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-fondo text-texto">
    <ToastContainer client:only="react" />

    <header class="sticky top-0 z-30 bg-secondary text-white shadow-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
        <a href="/admin" class="flex items-center gap-2.5 min-w-0">
          <img src="/Logo Blanco.png" alt="ArtesaNica" class="h-7 w-auto object-contain" />
          <span class="font-extrabold tracking-tight truncate">{t('admin.title')}</span>
        </a>

        <div class="flex items-center gap-2 shrink-0">
          <a
            href="/"
            class="text-xs sm:text-sm font-semibold text-white/85 hover:text-white transition-colors px-2 py-1 rounded"
          >
            {t('admin.backToSite')}
          </a>
          <button
            id="admin-theme-toggle"
            type="button"
            class="p-1.5 rounded-lg hover:bg-white/10 transition-colors"
            aria-label={t('nav.themeDark')}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script is:inline>
      document.getElementById('admin-theme-toggle')?.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('artesa-theme', isDark ? 'dark' : 'light');
        } catch (e) {}
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
      });
    </script>
  </body>
</html>
